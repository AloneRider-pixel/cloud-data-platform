# ============================================
# Cloud Data Platform - Environment Configuration
# ============================================

# Application
APP_NAME=cloud-data-platform
APP_ENV=development
DEBUG=true

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=data_platform
POSTGRES_USER=data_engineer
POSTGRES_PASSWORD=data_password

# Airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://data_engineer:data_password@postgres:5432/data_platform
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__SECRET_KEY=airflow-secret-key-change-me

# AWS / MinIO (S3-compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=raw-data-lake
S3_ENDPOINT=http://minio:9000

# MinIO Console
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# dbt
DBT_PROFILES_DIR=/root/.dbt
DBT_TARGET=dev

# Data Sources (Mock API)
MOCK_API_BASE_URL=http://mock-api:8001
MOCK_API_KEY=mock-api-key-123

# Alerting
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# Monitoring
DATA_FRESHNESS_SLA_HOURS=1
MAX_RETRY_COUNT=3
RETRY_DELAY_SECONDS=60
